# Server
PORT=3000
NODE_ENV=production

# SQLite database file (directory must be writable)
DB_PATH=./data/famli.db

# Set when running behind a reverse proxy (nginx, Traefik, Caddy...).
# "1" trusts one hop; also accepts "true", or a list like "loopback,uniquelocal".
# Needed for accurate rate limiting and Secure cookies over HTTPS.
TRUST_PROXY=

# Session cookie "Secure" flag: auto (default, Secure when served over HTTPS),
# true (always - use if TLS terminates at a proxy and TRUST_PROXY is set), or false.
COOKIE_SECURE=auto

# Default region for address labels and date formats (en-US, en-GB, en-CA, en-AU).
# Users can still pick their own in the account menu.
DEFAULT_LOCALE=en-US
